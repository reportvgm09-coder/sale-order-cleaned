{
  "name": "order-ledger-desktop",
  "productName": "Order Ledger",
  "version": "1.3.1",
  "description": "Order Ledger as a Windows program",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "in.orderledger.desktop",
    "productName": "Order Ledger",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "loading.html",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/order-ledger-server",
        "to": "server"
      },
      {
        "from": "vendor/mongodb",
        "to": "mongodb"
      },
      {
        "from": "../frontend/build",
        "to": "site"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Order Ledger",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
